{
  "hosting": {
    "public": "dist-firebase",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "**/*.apk", "**/*.aab"],
    "predeploy": ["npm run build", "node scripts/check-firebase-build.mjs"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      { "source": "**", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }, { "key": "X-Frame-Options", "value": "DENY" }, { "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }] },
      { "source": "/ocr-data/**", "headers": [{ "key": "Cache-Control", "value": "public,max-age=86400" }] },
      { "source": "/card-backs/**", "headers": [{ "key": "Cache-Control", "value": "public,max-age=604800" }] },
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
    ]
  },
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "database": { "rules": "database.rules.json" },
  "emulators": { "auth": { "port": 9099 }, "firestore": { "port": 8080 }, "database": { "port": 9000 }, "hosting": { "port": 5000 }, "ui": { "enabled": true, "port": 4000 }, "singleProjectMode": true }
}
