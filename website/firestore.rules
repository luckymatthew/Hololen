rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function common(id) {
      return request.resource.data.id == id
        && request.resource.data.schemaVersion == 1
        && request.resource.data.createdAt is number
        && request.resource.data.updatedAt is number
        && request.resource.data.createdAt > 0
        && request.resource.data.updatedAt >= request.resource.data.createdAt
        && request.resource.data.updatedAt <= request.time.toMillis() + 300000;
    }
    match /users/{uid} {
      allow read: if owner(uid);
      allow write: if false;
      match /decks/{deckId} {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && common(deckId)
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
          && request.resource.data.deck is map
          && request.resource.data.deck.oshi is map && request.resource.data.deck.main is map && request.resource.data.deck.cheer is map
          && request.resource.data.deck.oshi.size() <= 200 && request.resource.data.deck.main.size() <= 200 && request.resource.data.deck.cheer.size() <= 200;
        // The UI archives and restores. No accidental hard deletes during sync.
        allow delete: if false;
      }
      match /data/{documentId} {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && common(documentId)
          && documentId.matches('(settings|collection)(~[a-f0-9]{24})?')
          && request.resource.data.value is map;
        allow delete: if false;
      }
    }
  }
}
